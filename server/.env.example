# Server Environment Variables (Local Development)
# Copy this file to .env for local development

# Better Auth configuration
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URLS=http://localhost:5173

# Email (optional - for password reset)
# Without RESEND_API_KEY the reset link is printed to the server console.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=noreply@yourdomain.com

# GitHub OAuth (optional - for social login)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database is handled automatically
# - Local: Uses SQLite file at src/honomono.db
# - Production: Uses Cloudflare D1 via wrangler.toml binding