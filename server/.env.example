# Local development. `bun run setup` copies this file to .env.

# Better Auth
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
CLIENT_URLS=http://localhost:5173

# Email (optional). Used for password reset.
# If RESEND_API_KEY is not set, the server console shows the reset link.
# RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=noreply@yourdomain.com

# GitHub OAuth (optional). Used for social login.
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Database
# - Local: SQLite file at src/honomono.db
# - Production: Cloudflare D1, from the binding in wrangler.toml