{
  "name": "server",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "migrate": "bun run src/lib/migrate.ts",
    "migrate:remote": "bunx wrangler d1 migrations apply DATABASE --remote",
    "deploy": "bunx wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-path ../.gitignore .",
    "format": "oxfmt --ignore-path ../.gitignore .",
    "format:check": "oxfmt --ignore-path ../.gitignore --check ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3"
  }
}
