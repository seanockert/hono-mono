name = "your-app-name"
main = "src/index.ts"
compatibility_date = "2026-08-24"
compatibility_flags = ["nodejs_compat"]

# D1 is in one region. Smart placement runs the Worker near the database, so a
# request has one long round trip, not one for each query.
[placement]
mode = "smart"

[alias]
"bun:sqlite" = "./src/lib/bun-sqlite-stub.ts"

[vars]
# Public URLs. Change these to your deployment URLs.
BETTER_AUTH_URL = "https://your-app-name.workers.dev"
CLIENT_URLS = "https://your-app-name-client.pages.dev"
# Set BETTER_AUTH_SECRET as a Wrangler secret, not here.

[[d1_databases]]
binding = "DATABASE"
database_name = "your-app-name"
database_id = "xxx"
migrations_dir = "migrations"
