{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@server/*": ["./src/*"],
      "@client/*": ["../client/src/*"],
      "@shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
