# Cloudflare Pages response headers. The build copies this file to dist/.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; manifest-src 'self'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# connect-src allows all HTTPS origins, because each deployment has a different API URL.
# When you know your API URL, set it here:
#   connect-src 'self' https://your-app.your-name.workers.dev
