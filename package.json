{
  "name": "hono-auth",
  "version": "0.0.2",
  "description": "A monorepo with Bun, Hono, Vue, and Better Auth",
  "keywords": [
    "better-auth",
    "bun",
    "hono",
    "monorepo",
    "vite",
    "vue"
  ],
  "homepage": "",
  "license": "MIT",
  "author": "Sean Ockert",
  "workspaces": [
    "./server",
    "./client",
    "./shared"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "setup": "bun run scripts/setup.ts",
    "generate": "bun run scripts/generate-model.ts",
    "admin": "bun run scripts/promote-admin.ts",
    "deploy:setup": "bun run scripts/deploy-setup.ts",
    "build": "cd shared && bun run build && cd ../client && bun run build",
    "deploy": "cd server && bun run deploy && cd ../client && bun run deploy",
    "typecheck": "cd shared && bun run typecheck && cd ../server && bun run typecheck && cd ../client && bun run typecheck",
    "postinstall": "cd shared && bun run build",
    "lint": "oxlint --ignore-path .gitignore .",
    "format": "oxfmt --ignore-path .gitignore .",
    "format:check": "oxfmt --ignore-path .gitignore --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
